<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TeX2Word · 公式文档转换"
        Width="980" Height="660"
        MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="{DynamicResource CanvasBg}"
        Foreground="{DynamicResource TextPrimary}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Primary Accent Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="20,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBg}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressBg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDisabledBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentDisabledFg}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger / Stop Button -->
    <Style x:Key="DangerSoftButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BadgePdfBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary Outlined Button -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressBg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost Button -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Compact Row Action Icon Button -->
    <Style x:Key="RowIconButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Row Open Accent Pill Button -->
    <Style x:Key="RowAccentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBg}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented Pill RadioButton -->
    <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim Modern ScrollBar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/>
      <Setter Property="MinWidth" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3.5" Margin="1,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sleek Modern ProgressBar -->
    <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ProgressTrack}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                <Border CornerRadius="3">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#2563EB" Offset="0"/>
                      <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Queue File Card Item Template -->
    <DataTemplate x:Key="JobCardTemplate">
      <Border x:Name="Card"
              Background="{DynamicResource RowBg}"
              BorderBrush="{DynamicResource RowBorder}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="13,10"
              Margin="0,0,4,8"
              ToolTip="{Binding ToolTipSummary}">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick"
                        Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Format Pill Badge -->
          <Border x:Name="FmtBadge"
                  Grid.Column="0"
                  Width="38" Height="28"
                  CornerRadius="7"
                  BorderThickness="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource BadgeTexBg}"
                  BorderBrush="{DynamicResource BadgeTexBorder}">
            <TextBlock x:Name="FmtText"
                       Text="{Binding FormatTag}"
                       FontSize="10.5"
                       FontWeight="Bold"
                       FontFamily="Consolas, Segoe UI"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BadgeTexFg}"/>
          </Border>

          <!-- File Name + Output/Progress Detail -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding FileName}"
                         FontSize="13.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="420"/>
              <TextBlock Text="{Binding FileSizeText}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextMuted}"
                         VerticalAlignment="Bottom"
                         Margin="8,0,0,1"/>
            </StackPanel>
            <TextBlock x:Name="DetailLine"
                       Text="{Binding DetailText}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,3,0,0"/>
          </StackPanel>

          <!-- Status Pill + Quick Actions -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="StatusPill"
                    CornerRadius="11"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Background="{DynamicResource StatusPendingBg}">
              <TextBlock x:Name="StatusLabel"
                         Text="{Binding StatusText}"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource StatusPendingFg}"/>
            </Border>

            <!-- Done Actions -->
            <Button Style="{StaticResource RowAccentButtonStyle}"
                    Content="打开 Word"
                    Margin="0,0,4,0"
                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

            <Button Style="{StaticResource RowIconButtonStyle}"
                    ToolTip="在文件夹中显示"
                    Margin="0,0,2,0"
                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RevealItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Path Data="M3,5.5 A1.5,1.5 0 0,1 4.5,4 H9 L10.8,6 H19.5 A1.5,1.5 0 0,1 21,7.5 V18.5 A1.5,1.5 0 0,1 19.5,20 H4.5 A1.5,1.5 0 0,1 3,18.5 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
            </Button>

            <!-- Failed Actions -->
            <Button Style="{StaticResource RowIconButtonStyle}"
                    ToolTip="查看错误详情"
                    Margin="0,0,2,0"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.InspectErrorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Path Data="M12,3 A9,9 0 1,0 12,21 A9,9 0 1,0 12,3 Z M12,8 V13 M12,16.2 V16.4"
                    Stroke="{DynamicResource StatusFailedFg}"
                    StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
            </Button>

            <Button Style="{StaticResource RowIconButtonStyle}"
                    ToolTip="重新加入待转换队列"
                    Margin="0,0,2,0"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Path Data="M20,11 A8,8 0 1,0 18.2,16.5 M20,4 V11 H13"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
            </Button>

            <!-- Rename Output Action -->
            <Button Style="{StaticResource RowIconButtonStyle}"
                    ToolTip="自定义输出路径（另存为）"
                    Margin="0,0,2,0"
                    Visibility="{Binding CanEditOutput, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.RenameItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Path Data="M16.5,3.5 L20.5,7.5 L8,20 H4 V16 Z M13.5,6.5 L17.5,10.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
            </Button>

            <!-- Remove Action -->
            <Button Style="{StaticResource RowIconButtonStyle}"
                    ToolTip="从队列移除"
                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
              <Path Data="M6,6 L18,18 M18,6 L6,18"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round"
                    Width="11" Height="11" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource RowHoverBg}"/>
        </Trigger>
        <DataTrigger Binding="{Binding FormatTag}" Value="PDF">
          <Setter TargetName="FmtBadge" Property="Background" Value="{DynamicResource BadgePdfBg}"/>
          <Setter TargetName="FmtBadge" Property="BorderBrush" Value="{DynamicResource BadgePdfBorder}"/>
          <Setter TargetName="FmtText" Property="Foreground" Value="{DynamicResource BadgePdfFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding FormatTag}" Value="MD">
          <Setter TargetName="FmtBadge" Property="Background" Value="{DynamicResource BadgeMdBg}"/>
          <Setter TargetName="FmtBadge" Property="BorderBrush" Value="{DynamicResource BadgeMdBorder}"/>
          <Setter TargetName="FmtText" Property="Foreground" Value="{DynamicResource BadgeMdFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateName}" Value="Running">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/>
          <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource StatusRunningBg}"/>
          <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
          <Setter TargetName="DetailLine" Property="Foreground" Value="{DynamicResource AccentText}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateName}" Value="Done">
          <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource StatusDoneBg}"/>
          <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusDoneFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding StateName}" Value="Failed">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BadgePdfBorder}"/>
          <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource StatusFailedBg}"/>
          <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
          <Setter TargetName="DetailLine" Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <!-- Root Layout -->
  <Grid Margin="24,18,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1. Top Brand Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- App Vector Emblem -->
        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2563EB" Offset="0"/>
              <GradientStop Color="#4F46E5" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Path Data="M17,5 H6 L13,12 L6,19 H17"
                Stroke="#FFFFFF" StrokeThickness="2.3"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="TeX2Word" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <Border Background="{DynamicResource AccentSoftBg}"
                    BorderBrush="{DynamicResource AccentSoftBorder}"
                    BorderThickness="1" CornerRadius="9"
                    Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="v1.0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="PDF · TeX · Markdown 转可编辑 Word 文档（原生 MathType 公式）"
                     FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Header Right Pills & Controls -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Environment Status Pill -->
        <Button x:Name="EnvButton" Style="{StaticResource SecondaryButtonStyle}" Padding="11,6" Margin="0,0,8,0"
                ToolTip="点击查看本机 Microsoft Word 与 MathType 检测状态">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="EnvDot" Width="8" Height="8" Fill="{DynamicResource SuccessDot}" Margin="0,0,7,0"/>
            <TextBlock x:Name="EnvText" Text="Word · MathType 就绪" FontSize="12"/>
          </StackPanel>
        </Button>

        <!-- CLI Reference Button -->
        <Button x:Name="CliButton" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                ToolTip="查看命令行（CLI）用法">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M4,17 L10,11 L4,5 M12,19 H20"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
            <TextBlock Text="命令行" FontSize="12"/>
          </StackPanel>
        </Button>

        <!-- Theme Toggle Button -->
        <Button x:Name="ThemeButton" Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="31" Padding="0"
                ToolTip="切换浅色 / 深色主题">
          <Path x:Name="ThemeIcon"
                Data="M20.35,14.35 A8.5,8.5 0 0,1 9.65,3.65 A8.5,8.5 0 1,0 20.35,14.35 Z"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- 2. Main Workspace (Empty Dropzone OR Elevated Queue Card + Drag Overlay) -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <!-- Empty Hero Dropzone -->
      <Border x:Name="EmptyStateCard"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="24">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#0F172A" Opacity="0.06"/>
        </Border.Effect>
        <Grid x:Name="EmptyDropSurface" Cursor="Hand">
          <Rectangle RadiusX="11" RadiusY="11"
                     Stroke="{DynamicResource SubtleBorder}"
                     StrokeThickness="1.5"
                     StrokeDashArray="5 4"
                     Fill="{DynamicResource SubtleBg}"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <!-- Hero Icon Halo -->
            <Border Width="64" Height="64" CornerRadius="32"
                    Background="{DynamicResource AccentSoftBg}"
                    BorderBrush="{DynamicResource AccentSoftBorder}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
              <Path Data="M12,16 V6 M8,10 L12,6 L16,10 M5,17 V18.5 A1.5,1.5 0 0,0 6.5,20 H17.5 A1.5,1.5 0 0,0 19,18.5 V17"
                    Stroke="{DynamicResource AccentText}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Fill="Transparent" Width="26" Height="26" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="拖入 PDF、TeX 或 Markdown 文件到此处"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center"/>

            <!-- Format Pills Row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,18">
              <Border Background="{DynamicResource BadgePdfBg}" BorderBrush="{DynamicResource BadgePdfBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                <TextBlock Text="PDF" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BadgePdfFg}"/>
              </Border>
              <Border Background="{DynamicResource BadgeTexBg}" BorderBrush="{DynamicResource BadgeTexBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                <TextBlock Text="TeX" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BadgeTexFg}"/>
              </Border>
              <Border Background="{DynamicResource BadgeMdBg}" BorderBrush="{DynamicResource BadgeMdBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                <TextBlock Text="Markdown" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BadgeMdFg}"/>
              </Border>
              <TextBlock Text="→" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border Background="{DynamicResource AccentSoftBg}" BorderBrush="{DynamicResource AccentSoftBorder}" BorderThickness="1" CornerRadius="6" Padding="9,3">
                <TextBlock Text="Word (.docx + MathType)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
              </Border>
            </StackPanel>

            <Button x:Name="EmptyPickButton" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Padding="24,10">
              <StackPanel Orientation="Horizontal">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="#FFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/>
                <TextBlock Text="选择文档…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <TextBlock Text="支持多文件混合批量转换 · 本地离线识别 PDF 版面与公式 · 快捷键 Ctrl+O"
                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Active Queue Card -->
      <Border x:Name="QueueCard"
              Visibility="Collapsed"
              Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource CardBorder}"
              BorderThickness="1"
              CornerRadius="14">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#0F172A" Opacity="0.06"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Queue Header Toolbar -->
          <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBg}" BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="转换队列" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <Border Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource SubtleBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="9,0,0,0">
                  <TextBlock x:Name="QueueCountText" Text="0 份文件" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddMoreButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M12,5 V19 M5,12 H19"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                          Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                    <TextBlock Text="添加文件"/>
                  </StackPanel>
                </Button>
                <Button x:Name="ClearDoneButton" Style="{StaticResource GhostButtonStyle}" Content="清除已完成" Margin="0,0,2,0"/>
                <Button x:Name="ClearAllButton" Style="{StaticResource GhostButtonStyle}" Content="清空列表"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Scrollable Job Cards -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,10,4">
            <ItemsControl x:Name="JobsList" ItemTemplate="{StaticResource JobCardTemplate}"/>
          </ScrollViewer>

          <!-- Subtle Drop Hint Footer -->
          <Border Grid.Row="2" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource DividerBg}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="16,7">
            <TextBlock Text="继续拖入更多 PDF / TeX / Markdown 文件即可追加到队列 · 点击已完成项的“打开 Word”即可在 Word + MathType 中编辑"
                       FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
          </Border>
        </Grid>
      </Border>

      <!-- Drag-Over Highlight Overlay -->
      <Border x:Name="DragOverlay"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Background="{DynamicResource DropOverlayBg}"
              BorderBrush="{DynamicResource AccentBg}"
              BorderThickness="2"
              CornerRadius="14">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="62" Height="62" CornerRadius="31" Background="{DynamicResource AccentBg}" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Path Data="M12,16 V6 M8,10 L12,6 L16,10 M5,17 V18.5 A1.5,1.5 0 0,0 6.5,20 H17.5 A1.5,1.5 0 0,0 19,18.5 V17"
                  Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="Transparent" Width="26" Height="26" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="松开鼠标以添加到转换队列" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
          <TextBlock Text="支持 .pdf · .tex · .md · .markdown" FontSize="12.5"
                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 3. Settings & Optional Live Log Card -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,11"
            Margin="0,0,0,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Output Directory Picker -->
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="输出目录" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Grid.Column="1" Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource SubtleBorder}"
                    BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,0">
              <TextBlock x:Name="OutputDirText" Text="默认：各输入文件所在的目录"
                         FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <Button x:Name="PickDirButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="选择目录…" Margin="0,0,4,0"/>
            <Button x:Name="ResetDirButton" Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Content="恢复默认" Visibility="Collapsed"/>
          </Grid>

          <!-- Subtle Divider -->
          <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBg}" Margin="16,2"/>

          <!-- PDF Language Segmented Control -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="PDF 语言" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Background="{DynamicResource SubtleBg}" BorderBrush="{DynamicResource SubtleBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LangZhRadio" Style="{StaticResource SegmentedRadioStyle}"
                             GroupName="PdfLang" Content="中英混排" IsChecked="True"/>
                <RadioButton x:Name="LangEnRadio" Style="{StaticResource SegmentedRadioStyle}"
                             GroupName="PdfLang" Content="纯英文"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Collapsible Live Log Drawer -->
        <Border x:Name="LogDrawer" Visibility="Collapsed"
                Background="{DynamicResource LogBg}"
                BorderBrush="{DynamicResource LogBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,11,0,0"
                Padding="10,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="116"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
              <TextBlock Text="转换引擎实时日志" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyLogButton" Content="复制日志" Foreground="#93C5FD" Background="Transparent" BorderThickness="0"
                        FontSize="11.5" Cursor="Hand" Padding="6,2" Margin="0,0,6,0"/>
                <Button x:Name="ClearLogButton" Content="清空" Foreground="#94A3B8" Background="Transparent" BorderThickness="0"
                        FontSize="11.5" Cursor="Hand" Padding="6,2"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="LogTextBox" Grid.Row="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="{DynamicResource LogFg}"
                     BorderThickness="0"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     FontSize="11.5"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- 4. Bottom Status, Progress & Primary Action Bar -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,18,0">
        <TextBlock x:Name="StatusText"
                   Text="准备就绪 · 添加文件后点击“开始转换”（或按 F5）"
                   FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
        <ProgressBar x:Name="MainProgressBar" Style="{StaticResource ModernProgressBarStyle}"
                     Minimum="0" Maximum="100" Value="0"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ToggleLogButton" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="M4,6 H20 M4,12 H20 M4,18 H14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.7" StrokeStartLineCap="Round"
                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
            <TextBlock x:Name="ToggleLogLabel" Text="日志"/>
          </StackPanel>
        </Button>

        <Button x:Name="StopButton" Style="{StaticResource DangerSoftButtonStyle}" Visibility="Collapsed" Margin="0,0,10,0" Content="停止队列"/>

        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="126" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <Path Data="M6,4 L19,12 L6,20 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="11" Height="12" Stretch="Uniform" Margin="0,0,7,0"/>
            <TextBlock x:Name="StartButtonLabel" Text="开始转换"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
